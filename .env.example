# Agent Office — instance secrets (copy to .env, never commit .env)

# LLM / Hermes (adjust to your provider setup)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
GITHUB_TOKEN=

# Shared bus (inside compose network)
OFFICE_BUS_URL=redis://shared-memory:6379

# Door HMAC secrets must match crew/agents.json
# (set real values in agents.json; this file is for other env-based config)

# Optional manager webhook for notifications
# MANAGER_WEBHOOK_URL=
