# Agent Office — copy to .env (never commit .env).
#
# This file now holds ONLY non-secret compose parameters. All credentials
# (LLM keys, GitHub/Linear tokens, door secrets) live in the single
# gitignored file tokens/tokens.yaml — see docs/secrets.md. To consolidate
# any legacy credentials from .env into it, run:
#   python3 office/manage_tokens.py migrate

# Hermes process user inside containers (match host if volume permission issues)
HERMES_UID=501
HERMES_GID=20

# Bus URL as seen from the host (containers use redis://shared-memory:6379)
OFFICE_BUS_URL=redis://127.0.0.1:6380

# factory-control (lifecycle supervisor)
# (comments on their own lines: older compose .env parsers inline them)
IDLE_TIMEOUT_S=2400
CHECK_INTERVAL=120
WAKE_TIMEOUT_S=90

# Optional notifications
# MANAGER_WEBHOOK_URL=
