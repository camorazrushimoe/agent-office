# Agent Office — copy to .env (never commit .env)

# Required for agents to call the LLM (must match model provider in config.yaml)
CUSTOM_API_KEY=

# Optional
GITHUB_TOKEN=

# Hermes process user inside containers (match host if volume permission issues)
HERMES_UID=501
HERMES_GID=20

# Bus URL as seen from the host (containers use redis://shared-memory:6379)
OFFICE_BUS_URL=redis://127.0.0.1:6380

# factory-control (lifecycle supervisor)
IDLE_TIMEOUT_S=2400      # 40m idle -> stop agent container
CHECK_INTERVAL=120       # reaper scan period, seconds
WAKE_TIMEOUT_S=90        # max wait for agent health after wake

# Optional notifications
# MANAGER_WEBHOOK_URL=
