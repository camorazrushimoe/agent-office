# Workspace (project work lives outside foundation)
workspace/

# IDE
.idea/
.vscode/
*.swp

agents/*/hermes-home/.local/
agents/*/hermes-home/skills/
agents/*/hermes-home/review.md
agents/*/hermes-home/portfolio.yaml
instances/*/skills/

# Per-agent runtime memory (regrows every session; repo convention is to
# commit SOUL/config.template/skills, not runtime state — see
# docs/foundation-sync-plan.md, delta verdict)
agents/*/hermes-home/memories/

# Regenerable skill output (scrum-sweep sweep.py; the skill itself is tracked
# at agents/<role>/skills/)
agents/*/hermes-home/sweep-report.md

# Runtime sqlite state (same class as the already-ignored response_store.db*/state.db*)
agents/*/hermes-home/verification_evidence.db

# Nested repo clone in a runtime home (staff-engineer's, added by Architect R2:
# verified clean @ origin/main, 0/0 ahead-behind — runtime scaffolding, not a
# divergence. Do not let a live second clone live silently inside hermes-home.)
agents/staff-engineer/hermes-home/agent-office/

# NOTE: agents/*/hermes-home/plans/ is deliberately NOT ignored. A recurring
# untracked plans/ dir is a signal the next sync audit should see, not noise
# (docs/foundation-sync-plan.md — decision by staff-engineer, open to
# cross-review challenge).
