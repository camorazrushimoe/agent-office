# Instance config (secrets, real endpoints)
.env
.env.*
!.env.example
crew/agents.json
instances/*/crew/agents.json
instances/*/.env
instances/*/secrets/
# Single source of truth for ALL factory credentials. NEVER commit.
# tokens/tokens.example.yaml is the committed schema reference.
tokens/tokens.yaml
tokens/tokens.yaml.bak-*

# Per-agent env (contains real API keys)
agents/*/hermes-home/.env

# Rendered per-container config (contains resolved door secret)
agents/*/hermes-home/config.yaml
instances/*/home/*/config.yaml

