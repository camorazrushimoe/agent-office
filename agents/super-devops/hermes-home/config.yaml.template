model:
  default: stealth/ox-alpha
  provider: openrouter
platforms:
  webhook:
    enabled: true
    extra:
      port: 8644
      routes:
        inbox:
          secret: ${DOOR_SECRET}
          prompt: '{message}'
platform_toolsets:
  webhook:
    - hermes-cli
_config_version: 38
plugins:
  enabled: []
agent: {}
onboarding:
  seen:
    profile_build_offered: true
