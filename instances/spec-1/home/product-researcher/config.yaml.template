model:
  default: qwen3-8-27b
  provider: custom
  base_url: https://api.runinfra.ai/v1
  api_key: ${CUSTOM_API_KEY}
agent:
  api_max_retries: 8
platforms:
  webhook:
    enabled: true
    extra:
      port: 8644
      routes:
        inbox:
          secret: ${DOOR_SECRET}
          prompt: "{message}"
platform_toolsets:
  webhook:
    - hermes-cli
_config_version: 12
